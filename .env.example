# ==============================================================================
# EDU2 Educational RAG Parsing Pipeline — Configuration Template
# ==============================================================================
# Copy this file to `.env` and configure your API keys and local settings.
# NEVER commit your real `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vision-Language Model (VLM) & Cloud OCR (OpenRouter)
# ------------------------------------------------------------------------------
# OpenRouter powers the vision OCR parser (supports Qwen, Gemma, and Gemini).
# Get an API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Active VLM model for OpenRouter vision extraction
# Recommended choices:
#   - qwen/qwen3.8-flash            (Fast, accurate Arabic/English OCR, $0.15/1M tokens)
#   - google/gemma-4-31b-it         (Gemma 4 Multimodal 31B, $0.09/1M tokens)
#   - google/gemma-4-26b-a4b-it     (Gemma 4 Multimodal 26B A4B MoE)
#   - google/gemini-2.5-flash       (Gemini 2.5 Flash)
OPENROUTER_MODEL=qwen/qwen3.8-flash

# Optional: Attribution headers for OpenRouter API analytics / rankings
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=EDU2-RAG-Parser

# ------------------------------------------------------------------------------
# 2. LlamaParse Cloud Recovery (Emergency Fallback)
# ------------------------------------------------------------------------------
# Used only as a fallback engine when local parsers encounter unparseable formatting.
# Get free API credits at: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=

# ------------------------------------------------------------------------------
# 3. Local fallback OCR (Tesseract)
# ------------------------------------------------------------------------------
# If Tesseract is not in your system PATH, specify the absolute path here:
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: /usr/bin/tesseract or /opt/homebrew/bin/tesseract
TESSERACT_PATH=
TESSDATA_PREFIX=

# ------------------------------------------------------------------------------
# 4. FastAPI & Server Deployment Settings
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=false
API_DOCS_ENABLED=true

# Allowed CORS origins (comma-separated or * for all)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 5. Educational parsing defaults
# ------------------------------------------------------------------------------
# Parsing mode: 'auto' or 'standard'
DEFAULT_PARSING_MODE=auto
